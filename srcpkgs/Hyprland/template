post_install() {

# license
    vlicense LICENSE

# headers
    vmkdir usr/include/hyprland
    vmkdir usr/include/hyprland/protocols
    vmkdir usr/share/pkgconfig

    cmake --build ./build --config Release --target generate-protocol-headers

    find src -type f \( -name '*.hpp' -o -name '*.h' -o -name '*.inc' \) -print0 | cpio --quiet -0dump ${DESTDIR}/usr/include/hyprland
    install -Dm0644 protocols/*.h* ${DESTDIR}/usr/include/hyprland/protocols
    vinstall build/hyprland.pc 644 usr/share/pkgconfig
}

post_patch() {
    python3 -c '
import glob


# 1. Corregir string_view en hyprctl
for filepath in glob.glob("hyprctl/src/main.cpp", recursive=True):
    with open(filepath, "r") as f:
        content = f.read()
    target = "std::string socketPath = getRuntimeDir() + \"/\" + instanceSignature + \"/\" + filename;"
    replacement = "std::string socketPath = std::string(getRuntimeDir()) + \"/\" + std::string(instanceSignature) + \"/\" + std::string(filename);"
    if target in content:
        content = content.replace(target, replacement)
        with open(filepath, "w") as f:
            f.write(content)


# 2. Corregir el operador ternario en XWM.hpp
for filepath in glob.glob("src/xwayland/XWM.hpp", recursive=True):
    with open(filepath, "r") as f:
        content = f.read()
    target = "return m_connection ? *m_connection : nullptr;"
    replacement = "return m_connection ? m_connection->operator xcb_connection_t*() : nullptr;"
    if target in content:
        content = content.replace(target, replacement)
        with open(filepath, "w") as f:
            f.write(content)


# 3. Proveer DefaultConfig.hpp sin romper cadenas multilínea
for filepath in glob.glob("src/config/lua/DefaultConfig.hpp", recursive=True):
    with open("example/hyprland.lua", "r") as lua_file:
        lua_code = lua_file.read()
    
    escaped_lua = lua_code.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n\"\n\"")
    
    new_content = f"""// Parcheado para evitar #embed en GCC 14
inline constexpr const char* AUTOGENERATED_PREFIX_LUA = "-- This file is autogenerated. Do not edit!\\n\\n";
inline constexpr const char* EXAMPLE_CONFIG_LUA = "{escaped_lua}";
"""
    with open(filepath, "w") as f:
        f.write(new_content)


# 4. Corregir la suma de string y string_view en ParserUtils.cpp
for filepath in glob.glob("src/config/shared/parserUtils/ParserUtils.cpp", recursive=True):
    with open(filepath, "r") as f:
        content = f.read()
    target = "strToNumber<uint64_t>(std::string{\"0x\"} + value);"
    replacement = "strToNumber<uint64_t>(std::string{\"0x\"} + std::string{value});"
    if target in content:
        content = content.replace(target, replacement)
        with open(filepath, "w") as f:
            f.write(content)


# 5. Corregir la comprobación en MiscFunctions.cpp convirtiendo a std::string temporal
for filepath in glob.glob("src/helpers/MiscFunctions.cpp", recursive=True):
    with open(filepath, "r") as f:
        content = f.read()
    target = "return (... || std::ranges::starts_with(str_view, prefixes));"
    replacement = "return (... || std::string{str_view.begin(), str_view.end()}.starts_with(prefixes));"
    if target in content:
        content = content.replace(target, replacement)
        with open(filepath, "w") as f:
            f.write(content)


# 6. Corregir insert_range en Monitor.cpp por el método tradicional de iteradores
for filepath in glob.glob("src/output/Monitor.cpp", recursive=True):
    with open(filepath, "r") as f:
        content = f.read()
    target = "requestedModes.insert_range(requestedModes.end(), sortedModes | std::views::reverse);"
    replacement = "requestedModes.insert(requestedModes.end(), sortedModes.rbegin(), sortedModes.rend());"
    if target in content:
        content = content.replace(target, replacement)
        with open(filepath, "w") as f:
            f.write(content)
            print("¡Parche de Monitor.cpp aplicado con éxito!")
'
}
