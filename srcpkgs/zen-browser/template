do_install() {
    # Creamos el directorio de destino en usr/lib
    vmkdir usr/lib/zen-browser
    vmkdir usr/bin

    # Copiamos todo el contenido extraído dentro de su carpeta en lib
    vcopy . usr/lib/zen-browser

    # Creamos el symlink oficial para que quede disponible en el PATH (/usr/bin)
    ln -sf /usr/lib/zen-browser/zen ${DESTDIR}/usr/bin/zen
}
