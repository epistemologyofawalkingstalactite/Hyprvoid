post_patch() {
    python3 - << 'EOF'
import pathlib, re

for path in pathlib.Path("src").rglob("*.cpp"):
    content = path.read_text(encoding="utf-8")
    if "append_range" in content:
        # Reemplazar apéndices de listas con llaves {}
        content = re.sub(
            r"([a-zA-Z0-9_.]+)\.append_range\s*\(\s*(std::vector<[^>]+>)?\s*(\{.*?\})\s*\)\s*;",
            r"\1.insert(\1.end(), \3);",
            content,
            flags=re.DOTALL
        )
        # Reemplazar append_range general usando un bloque de ámbito aislado
        content = re.sub(
            r"([a-zA-Z0-9_.]+)\.append_range\s*\(\s*(.+?)\s*\)\s*;",
            r"{ auto _v = \2; \1.insert(\1.end(), _v.begin(), _v.end()); }",
            content
        )
        path.write_text(content, encoding="utf-8")
        print(f"--> Parche de compatibilidad append_range aplicado en {path}")
EOF
}
