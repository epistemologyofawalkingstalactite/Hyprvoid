do_install() {
    # Creamos el directorio de librerías y el bin
    vmkdir usr/lib/obsidian
    vmkdir usr/bin

    # Copiamos los archivos extraídos al directorio de lib
    vcopy . usr/lib/obsidian

    # Creamos el symlink para el ejecutable principal
    ln -sf /usr/lib/obsidian/obsidian ${DESTDIR}/usr/bin/obsidian
}
